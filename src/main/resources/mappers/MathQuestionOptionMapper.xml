<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.math.alstudymathjava.system.mapper.MathQuestionOptionMapper">

    <resultMap id="BaseResultMap" type="com.math.alstudymathjava.system.entity.math.MathQuestionOption">
        <id column="id" property="id"/>
        <result column="question_id" property="questionId"/>
        <result column="option_label" property="optionLabel"/>
        <result column="option_content" property="optionContent"/>
        <result column="is_correct" property="isCorrect"/>
        <result column="sort_order" property="sortOrder"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, question_id, option_label, option_content, is_correct, sort_order
    </sql>

    <!-- 新增单个选项 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO math_question_option
        (
            question_id,
            option_label,
            option_content,
            is_correct,
            sort_order
        )
        VALUES
            (
                #{questionId},
                #{optionLabel},
                #{optionContent},
                #{isCorrect},
                #{sortOrder}
            )
    </insert>

    <!-- 批量新增选项 -->
    <insert id="batchInsert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO math_question_option
        (
        question_id,
        option_label,
        option_content,
        is_correct,
        sort_order
        )
        VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.questionId},
            #{item.optionLabel},
            #{item.optionContent},
            #{item.isCorrect},
            #{item.sortOrder}
            )
        </foreach>
    </insert>

    <!-- 更新单个选项 -->
    <update id="update">
        UPDATE math_question_option
        <set>
            <if test="questionId != null">question_id = #{questionId},</if>
            <if test="optionLabel != null">option_label = #{optionLabel},</if>
            <if test="optionContent != null">option_content = #{optionContent},</if>
            <if test="isCorrect != null">is_correct = #{isCorrect},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据ID删除单个选项 -->
    <delete id="deleteById">
        DELETE FROM math_question_option WHERE id = #{id}
    </delete>

    <!-- 根据题目ID删除该题目的所有选项 -->
    <delete id="deleteByQuestionId">
        DELETE FROM math_question_option WHERE question_id = #{questionId}
    </delete>

    <!-- 根据题目ID查询该题目的所有选项（按 sortOrder 排序） -->
    <select id="selectByQuestionId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM math_question_option
        WHERE question_id = #{questionId}
        ORDER BY sort_order ASC, id ASC
    </select>

</mapper>