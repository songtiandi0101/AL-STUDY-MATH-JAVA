<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.math.alstudymathjava.system.mapper.SysUserRoleMapper">

    <resultMap id="BaseResultMap" type="com.math.alstudymathjava.system.entity.user.SysUserRole">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="role_id" property="roleId"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user_role(user_id,role_id) VALUES (#{userId},#{roleId})
    </insert>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM sys_user_role WHERE user_id = #{userId}
    </select>

    <delete id="deleteById">
        DELETE FROM sys_user_role WHERE id = #{id}
    </delete>
</mapper>
