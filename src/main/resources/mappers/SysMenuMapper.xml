<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.math.alstudymathjava.system.mapper.SysMenuMapper">

    <resultMap id="BaseResultMap" type="com.math.alstudymathjava.system.entity.user.SysMenu">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="menu_name" property="menuName"/>
        <result column="path" property="path"/>
        <result column="icon" property="icon"/>
        <result column="sort" property="sort"/>
        <result column="visible" property="visible"/>
        <result column="type" property="type"/>
        <result column="del_flag" property="delFlag"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_menu (parent_id,menu_name,path,icon,sort,visible,type,del_flag,create_time,update_time)
        VALUES (#{parentId},#{menuName},#{path},#{icon},#{sort},#{visible},#{type},#{delFlag},#{createTime},#{updateTime})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM sys_menu WHERE id = #{id} AND del_flag = 0
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT * FROM sys_menu
        WHERE del_flag = 0
        <if test="menuName != null and menuName != ''">
            AND menu_name LIKE CONCAT('%',#{menuName},'%')
        </if>
    </select>

    <update id="update">
        UPDATE sys_menu
        SET parent_id=#{parentId},menu_name=#{menuName},path=#{path},icon=#{icon},sort=#{sort},visible=#{visible},type=#{type},update_time=#{updateTime}
        WHERE id = #{id}
    </update>

    <update id="deleteById">
        UPDATE sys_menu SET del_flag=1 WHERE id = #{id}
    </update>

    <select id="selectMenuByRoleId" resultMap="BaseResultMap">
        SELECT m.*
        FROM sys_menu m
                 INNER JOIN sys_role_menu rm ON m.id = rm.menu_id
        WHERE rm.role_id = #{roleId}
          AND m.visible = 1
          AND m.del_flag = 0
        ORDER BY m.sort ASC
    </select>

    <select id="getMenuTreeAll" resultMap="BaseResultMap">
        SELECT m.*
        FROM sys_menu m
        WHERE m.visible = 1
          AND m.del_flag = 0
        ORDER BY m.sort ASC
    </select>

</mapper>
