<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.math.alstudymathjava.system.mapper.SysPermissionMapper">

    <resultMap id="BaseResultMap" type="com.math.alstudymathjava.system.entity.user.SysPermission">
        <id column="id" property="id"/>
        <result column="perm_code" property="permCode"/>
        <result column="perm_name" property="permName"/>
        <result column="del_flag" property="delFlag"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_permission (perm_code,perm_name,del_flag,create_time,update_time)
        VALUES (#{permCode},#{permName},#{delFlag},#{createTime},#{updateTime})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM sys_permission WHERE id = #{id} AND del_flag = 0
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT * FROM sys_permission
        WHERE del_flag = 0
        <if test="permCode != null and permCode != ''">
            AND perm_code LIKE CONCAT('%',#{permCode},'%')
        </if>
    </select>

    <update id="update">
        UPDATE sys_permission
        SET perm_code=#{permCode},perm_name=#{permName},update_time=#{updateTime}
        WHERE id = #{id}
    </update>

    <update id="deleteById">
        UPDATE sys_permission SET del_flag=1 WHERE id = #{id}
    </update>
</mapper>
